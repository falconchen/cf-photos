{
  "manifest_version": 3,
  "name": "PhotoFlare 图床助手",
  "version": "1.0.0",
  "description": "右键或在弹窗里勾选网页图片，一键存入 PhotoFlare 图床并复制链接。",
  "browser_specific_settings": {
    "gecko": {
      "id": "photoflare@falconchen.dev",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PhotoFlare 图床助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "activeTab",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"]
}
