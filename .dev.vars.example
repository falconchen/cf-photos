AUTH_TOKEN=replace-with-a-long-random-token
WEBDAV_URL=https://example.com/dav
WEBDAV_USERNAME=your-username
WEBDAV_PASSWORD=your-password
# 可选：图片路径的时区偏移（小时），默认 8；本地覆盖 wrangler.toml 中的同名 vars
TIMEZONE_OFFSET=8
# 可选：上传时把 JPEG / PNG / HEIC 自动转成 WebP，默认关闭；需要自托管的 imaginary 服务
# AUTO_WEBP=true
# WEBP_CONVERTER_URL=http://127.0.0.1:8088
# WEBP_CONVERTER_TOKEN=imaginary-api-key
